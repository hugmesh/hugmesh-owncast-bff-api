<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- The org metapom — consolidates the Spring Boot 4.0.2 / Java 25 reactive BFF
       baseline (WebFlux + Casdoor OAuth2 resource server + R2DBC/Liquibase +
       SpringDoc), the shared <dependencies>, the dependencyManagement for
       hugmesh-commons, and the pluginManagement (compiler / surefire
       bytebuddy flag / spring-boot / native). hugmesh-parent is itself a child of
       spring-boot-starter-parent:4.0.2, so the Spring Boot dependency + plugin
       management is inherited TRANSITIVELY. -->
  <parent>
    <groupId>systems.hugmesh</groupId>
    <artifactId>hugmesh-parent</artifactId>
    <version>2.8.0</version>
    <relativePath/>
  </parent>

  <!-- NO -api suffix in the artifactId (mirrors wiki-bff / forum-bff / user-bff /
       admin-bff): -api is only in the repo/service/image name. -->
  <artifactId>owncast-bff</artifactId>
  <version>0.2.0</version>

  <properties>
    <!-- java.version (25), encoding, the hugmesh-commons version and the
         springdoc version are all inherited from hugmesh-parent. -->
  </properties>

  <dependencies>
    <!-- The shared, canonical HugMesh security/tenancy/config/web building blocks
         (Casdoor JWT authorities, issuer->domain DomainRegistry, Roles helper, the
         config-gated multi-issuer TenancyResourceServerConfig, the static-utility
         DomainScope predicate helper, the BFF ApiException). Version is MANAGED by
         hugmesh-parent's dependencyManagement, so NO <version> here. This replaces
         this repo's deleted local copies of security.{Roles,DomainRegistry,DomainScope,
         CasdoorAuthorities} + config.TenancyResourceServerConfig + web.ApiException. -->
    <dependency>
      <groupId>systems.hugmesh</groupId>
      <artifactId>hugmesh-commons</artifactId>
    </dependency>

    <!-- The canonical shared Testcontainers-Postgres base (PostgresTestSupport):
         full-context @SpringBootTest integration tests extend it to boot the real
         R2DBC + Liquibase stack over a fresh per-class Postgres database (Boot-4
         dual-connection-safe), replacing the old in-mem H2 dual-connection
         TestDatabaseConfig that breaks under Boot 4. Published as a test-jar; the
         version is parent-managed so no <version> is needed here. -->
    <dependency>
      <groupId>systems.hugmesh</groupId>
      <artifactId>hugmesh-commons</artifactId>
      <version>2.1.0</version>
      <classifier>tests</classifier>
      <scope>test</scope>
    </dependency>

    <!-- ============================================================================
         The core reactive BFF stack (webflux / actuator / security /
         oauth2-resource-server / validation), the data-access stack (data-r2dbc /
         r2dbc-postgresql / liquibase-core / spring-jdbc / postgresql), springdoc, and
         the whole test stack (spring-boot-starter-test / reactor-test /
         spring-security-test / r2dbc-h2 / h2) are INHERITED from hugmesh-parent's
         common <dependencies>. They were removed here to de-duplicate. This repo has
         NO further repo-specific runtime dependencies beyond the commons library.
         ============================================================================ -->
  </dependencies>

  <build><plugins>
    <!-- The spring-boot, native and surefire (bytebuddy-experimental argLine)
         plugins are configured in hugmesh-parent's pluginManagement; declaring
         them here (no config) binds the managed config. The native plugin is bound
         so `./mvnw -Pnative native:compile` works; spring-boot repackages the app. -->
    <plugin>
      <groupId>org.graalvm.buildtools</groupId>
      <artifactId>native-maven-plugin</artifactId>
    </plugin>
    <plugin>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-maven-plugin</artifactId>
    </plugin>
  </plugins></build>

  <profiles>
    <!-- Native build: `./mvnw -Pnative native:compile` produces a GraalVM binary.
         The parent's native plugin management does the heavy lifting; this thin
         local profile mirrors wiki-bff so the same `-Pnative` invocation works. -->
    <profile>
      <id>native</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
